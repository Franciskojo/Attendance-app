# ================================================================
# ATTENDANCE MANAGEMENT SAAS - ENVIRONMENT CONFIGURATION
# ================================================================
# Duplicate this file as .env.local for local development, or add
# these key-value pairs to your hosting dashboard (e.g., Vercel).
# ================================================================

# 1. MongoDB Atlas Connection URI
# Required for persistent production storage.
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_host>/attendance_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@attendancedb.t56fghx.mongodb.net/attendance_db?retryWrites=true&w=majority

# 2. NextAuth Configuration
# NEXTAUTH_SECRET: A strong 32+ character random string to sign JWT session tokens.
# Generate one using terminal: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secret_32_character_jwt_token_here

# NEXTAUTH_URL: The canonical URL of your hosted application.
# For local development: http://localhost:3000
# For production: https://your-app-name.vercel.app
NEXTAUTH_URL=http://localhost:3000

# 3. Public Application Base URL
# Used on the client side to generate full QR code check-in URLs.
# For local development: http://localhost:3000
# For production: https://your-app-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. (Optional) Database Seed Secret
# Protects the /api/seed endpoint in production from unauthorized invocation.
SEED_SECRET=your_optional_secret_token_for_manual_api_seeding
